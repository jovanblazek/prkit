{
  "name": "prkit",
  "version": "1.0.0",
  "description": "CLI for creating GitHub pull requests from ticket context.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "prkit": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/main.ts",
    "format": "prettier --write .",
    "lint": "oxlint .",
    "start": "node dist/cli/main.js",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:unit": "vitest run tests/unit tests/adapters",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "commander": "14.0.3",
    "minimatch": "10.2.5",
    "prompts": "2.4.2",
    "yaml": "2.8.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.1",
    "oxlint": "1.63.0",
    "prettier": "3.8.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
