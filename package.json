{
  "name": "prkit",
  "version": "1.0.0",
  "description": "Simple Node.js TypeScript starter for a future CLI app.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "prkit": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "format": "prettier --write .",
    "lint": "oxlint .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:unit": "vitest run tests/unit tests/adapters",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "commander": "^14.0.1",
    "minimatch": "^10.1.1",
    "prompts": "^2.4.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^25.6.1",
    "oxlint": "^1.63.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
