{
  "name": "prkit",
  "version": "1.0.0",
  "description": "Simple Node.js TypeScript starter for a future CLI app.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "format": "prettier --write .",
    "lint": "oxlint .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@types/node": "^25.6.1",
    "oxlint": "^1.63.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
